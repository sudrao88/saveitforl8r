{
  "name": "saveitforl8r-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w saveitforl8r",
    "build": "npm run build -w saveitforl8r",
    "preview": "npm run preview -w saveitforl8r",
    "test": "npm run test -w saveitforl8r",
    "lint": "eslint apps/**/*.{ts,tsx} packages/**/*.{ts,tsx}",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.57.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash -c 'tsc --noEmit -p apps/saveitforl8r/tsconfig.json'"
    ]
  }
}
